# HiveMemory 环境变量配置模板
#
# 使用说明：
#   1. 复制此文件为 .env（或 configs/.env）
#   2. 填入必要的 API Keys 和基础设施地址
#   3. 模型列表（display_name、litellm_model、温度等）在 configs/models.yaml 中管理
#   4. Provider 凭证也可通过前端"提供商凭证"界面配置（写入 configs/providers.secrets.yaml）
#      环境变量优先级 > providers.secrets.yaml > 无凭证
#
# 格式说明：
#   环境变量使用 HIVEMEMORY__ 前缀，层级间使用双下划线 __ 分隔


# ============================================================
# 提供商凭证（Secrets）
# ============================================================
# Provider 名称需与 configs/models.yaml 中模型的 provider 字段一致（大小写不敏感）
# 可按需添加任意 provider：openai、anthropic、gemini 等，格式相同

# DeepSeek
HIVEMEMORY__PROVIDERS__DEEPSEEK__API_KEY=sk-your-deepseek-api-key-here
HIVEMEMORY__PROVIDERS__DEEPSEEK__API_BASE=https://api.deepseek.com

# OpenAI（如使用）
# HIVEMEMORY__PROVIDERS__OPENAI__API_KEY=sk-your-openai-api-key-here
# HIVEMEMORY__PROVIDERS__OPENAI__API_BASE=

# Anthropic（如使用）
# HIVEMEMORY__PROVIDERS__ANTHROPIC__API_KEY=sk-ant-your-key-here
# HIVEMEMORY__PROVIDERS__ANTHROPIC__API_BASE=


# ============================================================
# 内部引擎模型覆盖（可选）
# ============================================================
# Gateway 和 Librarian 默认使用 configs/models.yaml 中标记为 is_default 的模型。
# 若需为某个引擎单独指定模型，取消注释并填入注册表中的模型 ID。

# HIVEMEMORY__SHARED__LLM__GATEWAY__MODEL_ID=deepseek-chat
# HIVEMEMORY__SHARED__LLM__LIBRARIAN__MODEL_ID=deepseek-chat


# ============================================================
# 基础设施（Infrastructure）
# ============================================================
# Qdrant 向量数据库（留空则使用 config.yaml 中的默认值）
HIVEMEMORY__QDRANT__HOST=localhost
HIVEMEMORY__QDRANT__PORT=6333
# HIVEMEMORY__QDRANT__API_KEY=


# ============================================================
# 运行时配置（Runtime）
# ============================================================
# 调试模式（true/false）
HIVEMEMORY__SYSTEM__DEBUG=false

# 日志级别（DEBUG / INFO / WARNING / ERROR）
HIVEMEMORY__LOGGING__LEVEL=INFO

# 指定配置文件路径（可选，默认为 configs/config.yaml）
# HIVEMEMORY_CONFIG_PATH=/path/to/custom/config.yaml


# ============================================================
# 服务器部署（Server Deployment，可选）
# ============================================================
# 是否由 FastAPI 直接托管前端构建产物（生产/Docker 模式，默认 false）
# HIVEMEMORY_SERVE_FRONTEND=false

# 前端构建产物目录（默认 frontend/dist）
# HIVEMEMORY_FRONTEND_DIST_DIR=/path/to/frontend/dist