# Copy this file to .hivememory/dev.env on the workstation:
#   cp scripts/hivememory-dev.env.example .hivememory/dev.env
#
# The dev.env file is ignored by Git. It contains local paths only.

# Absolute path to the Linux Qdrant executable.
QDRANT_BIN="$HOME/services/qdrant/qdrant"

# Persistent Qdrant data. Keep this outside the source tree if preferred.
# QDRANT_STORAGE_PATH="$HOME/.local/share/hivememory/qdrant"

# The script uses Node from nvm. This must be installed for the same Linux user.
HIVEMEMORY_NODE_VERSION="22"

# The default ports match the repository configuration.
# QDRANT_HTTP_PORT="6333"
# QDRANT_GRPC_PORT="6334"
# HIVEMEMORY_BACKEND_PORT="8769"
# HIVEMEMORY_FRONTEND_PORT="5173"
