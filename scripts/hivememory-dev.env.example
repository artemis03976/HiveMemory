# Copy this file to .hivememory/dev.env on the workstation:
#   cp scripts/hivememory-dev.env.example .hivememory/dev.env
#
# The dev.env file is ignored by Git. It contains local paths only.

# Windows (scripts/hivememory-dev.ps1) reads only QDRANT_BIN and
# QDRANT_STORAGE_PATH from this file and does not expand variables such as
# $HOME: write absolute Windows paths, for example
#   QDRANT_BIN="D:\services\qdrant\qdrant.exe"
#   QDRANT_STORAGE_PATH="D:\HiveMemoryData\qdrant"

# Absolute path to the Qdrant executable.
QDRANT_BIN="$HOME/services/qdrant/qdrant"

# Persistent Qdrant data. Keep this outside the source tree if preferred.
# QDRANT_STORAGE_PATH="$HOME/.local/share/hivememory/qdrant"

# The WSL/Linux script uses Node from nvm. This must be installed for the same
# Linux user. Not used on Windows.
HIVEMEMORY_NODE_VERSION="22"

# Development mode (start) reloads the backend on code changes. Set to 0 to keep
# it running across edits; serve mode never reloads regardless of this value.
# HIVEMEMORY_BACKEND_RELOAD="1"

# Seconds stop/restart waits for the backend to settle in-memory topics before
# forcing it down. Raise it if the backend log shows shutdown being cut short.
# HIVEMEMORY_BACKEND_STOP_TIMEOUT="60"

# The default ports match the repository configuration.
# QDRANT_HTTP_PORT="6333"
# QDRANT_GRPC_PORT="6334"
# HIVEMEMORY_BACKEND_PORT="8769"
# HIVEMEMORY_FRONTEND_PORT="5173"
