      "category": "explicit_entity_association",
      "description": "验证在无上下文时，能否识别专有名词（Project Titan）作为搜索锚点，并正确召回相关技术栈配置",
      "sessions": [
        {
          "session_id": "titan_session_a",
          "phase": "memory_recording",
          "description": "记忆录入 - 设定 Project Titan 的技术栈配置",
          "input": {
