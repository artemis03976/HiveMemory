          "expected": {
            "gateway": {
              "intent": "RAG",
              "rewritten_contains": ["Project Titan", "用户登录", "接口"],
              "keywords_any": ["Project Titan", "登录", "API", "JWT"]
            },
            "retrieval": {
              "recall_memory_tags": ["Project Titan", "FastAPI"],
              "min_recall_count": 1
            },
            "agent_behavior": {
