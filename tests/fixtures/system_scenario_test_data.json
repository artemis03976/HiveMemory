    {
      "id": "SYS-SCENARIO-002",
      "name": "暗影之剑 - 属性检索与设定一致性",
      "priority": "P0",
      "category": "attribute_retrieval",
      "description": "验证对于特定虚构实体（霜之哀伤的碎片）的属性检索，确保设定一致性",
      "sessions": [
        {
          "session_id": "frostmourne_session_a",
          "phase": "memory_recording",
          "description": "记忆录入 - 设定武器属性",
          "input": {
            "identity": {
              "user_id": "test_user_frostmourne",
              "agent_id": "test_agent",
              "session_id": "frostmourne_session_a"
            },
            "interactions": [
              {
                "role": "user",
                "content": "我在写一个奇幻小说，需要设定一把武器叫「霜之哀伤的碎片」。它的特性是这样的：攻击时会发出幽蓝色的光芒，非常耀眼；而且使用者会持续受到武器的反噬，每秒扣除 5 点生命值，这是使用这把神器的代价。这把武器的来历是从巫妖王阿尔萨斯的神剑「霜之哀伤」上剥落的一块碎片，虽然只是碎片但依然蕴含着强大的死亡之力。",
                "rewritten_query": "设定武器「霜之哀伤的碎片」的属性：蓝光、每秒扣5点生命值、来自巫妖王神剑"
              },
              {
                "role": "assistant",
                "content": "我记录了「霜之哀伤的碎片」的完整设定：\n\n**武器名称**：霜之哀伤的碎片\n\n**外观效果**：\n- 攻击时发出幽蓝色的耀眼光芒\n\n**特殊效果**：\n- 反噬机制：使用者每秒扣除 5 点生命值\n- 这是使用神器的代价\n\n**背景故事**：\n- 来源：巫妖王阿尔萨斯的神剑「霜之哀伤」的碎片\n- 虽为碎片，仍蕴含强大的死亡之力\n\n这个设定很有魔幻史诗的感觉，反噬机制让武器的使用充满了戏剧性的代价感。后续写作中如果需要调用这个设定，我会保持一致。"
              }
            ]
          },
          "expected": {
            "flush_triggered": true,
            "memory_created": true,
            "memory_type": "FACT",
            "title_contains_any": ["霜之哀伤", "武器", "设定"],
            "tags_contains": ["霜之哀伤的碎片", "武器", "奇幻"],
            "content_contains": ["每秒扣除 5 点生命值", "幽蓝色", "巫妖王"]
          }
        },
        {
          "session_id": "frostmourne_session_b",
          "phase": "cross_session_retrieval",
          "description": "跨窗口唤醒 - 询问武器副作用",
          "input": {
            "identity": {
              "user_id": "test_user_frostmourne",
              "agent_id": "test_agent",
              "session_id": "frostmourne_session_b"
            },
            "context": [],
            "interactions": [
              {
                "role": "user",
                "content": "我小说里的战士角色要拿起「霜之哀伤的碎片」战斗了，使用这把武器会有什么副作用来着？我需要在战斗场景里描写出来。"
              }
            ]
          },
          "expected": {
            "gateway": {
              "intent": "RAG",
              "rewritten_contains": ["霜之哀伤的碎片", "副作用"],
              "keywords_any": ["霜之哀伤的碎片", "武器", "副作用"]
            },
            "retrieval": {
              "recall_memory_tags": ["霜之哀伤的碎片"],
              "min_recall_count": 1
            },
            "agent_behavior": {
              "response_must_contain": ["每秒扣除 5 点生命值"],
              "response_should_contain_any": ["反噬", "代价", "生命值"]
            }
          }
        }
      ]
