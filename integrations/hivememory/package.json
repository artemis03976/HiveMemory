{
  "name": "hivememory-connector",
  "description": "把 pi 与 DeepSeek Harness 中已经结束的对话轮次导入 HiveMemory，并让其中的 Agent 经扩展注册的工具检索、读取、写入与更新 HiveMemory 的记忆；pi 另外附带引导 agent 使用记忆工具的 skill。",
  "private": true,
  "type": "module",
  "main": "node/dsh/index.js",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"node/test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./node/dsh/cordis.patch.yml"
    }
  },
  "pi": {
    "extensions": [
      "./node/pi/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
